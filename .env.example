NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB
API_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
REQUIRE_API_KEY=true
TRUST_PROXY=false
UPLOAD_DIR=/data/uploads
PERSISTENT_STORAGE_CONFIRMED=true
MAX_UPLOAD_BYTES=524288000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
REQUEST_TIMEOUT_MS=120000
MALWARE_SCAN_URL=https://scanner.internal.example/scan
MALWARE_SCAN_TOKEN=REPLACE_WITH_SCANNER_TOKEN
MALWARE_SCAN_TIMEOUT_MS=30000
C2PA_VERIFY_TRUST=true
C2PA_OCSP_FETCH=false
