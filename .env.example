NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB
API_KEY=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
REQUIRE_API_KEY=true
TRUST_PROXY=false
UPLOAD_DIR=/tmp/spr-media-uploads
MAX_UPLOAD_BYTES=524288000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
REQUEST_TIMEOUT_MS=120000
MALWARE_SCAN_URL=http://scanner-adapter.railway.internal:8080/scan
MALWARE_SCAN_ALLOW_PRIVATE_HTTP=true
MALWARE_SCAN_TOKEN=REPLACE_WITH_SCANNER_SHARED_SECRET_32_PLUS_CHARS
MALWARE_SCAN_TIMEOUT_MS=30000
C2PA_VERIFY_TRUST=true
C2PA_OCSP_FETCH=false

# Optional authenticated action-result connector; both values required to enable it.
TRUSTED_ACTION_SOURCE=your-authoritative-gateway
TRUSTED_ACTION_WEBHOOK_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Optional SPR-backed machine-to-machine trust integration.
SPR_M2M_BASE_URL=https://your-spr-api.example.com
SPR_M2M_API_KEY=REPLACE_WITH_SPR_LIVE_API_KEY_32_PLUS_CHARS
M2M_ENVELOPE_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
